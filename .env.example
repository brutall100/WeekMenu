# Nukopijuok į `.env` ir įrašyk savo reikšmes.
# .env NIEKADA nepatenka į git (žr. .gitignore).

# Claude API raktas – iš https://console.anthropic.com/
# Be jo svetainė veikia, tik AI generavimo mygtukai bus išjungti.
ANTHROPIC_API_KEY=

# Kurį modelį naudoti generavimui (neprivaloma)
WEEKMENU_AI_MODEL=claude-opus-5

# Kur laikyti Deno KV duomenų bazę lokaliai (neprivaloma).
# Deno Deploy šitą ignoruoja – ten KV duodama automatiškai.
WEEKMENU_KV_PATH=./data/weekmenu.kv

# Slaptas raktas statistikos skydeliui /statistika
# BE ŠITO RAKTO SKYDELIO NĖRA – puslapis grąžina 404.
# Sugalvok ilgą atsitiktinę eilutę, pvz.: openssl rand -hex 24
WEEKMENU_STATS_TOKEN=
